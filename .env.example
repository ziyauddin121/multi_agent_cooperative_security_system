# ============================================================
# Multi-Agent Cooperative Security System — Environment Config
# Copy this file to .env and update the values.
# ============================================================

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=macss_db
POSTGRES_USER=macss_user
POSTGRES_PASSWORD=macss_pass
DATABASE_URL=postgresql+asyncpg://macss_user:macss_pass@postgres:5432/macss_db

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production
DEBUG=true

# --- Agents ---
AGENT_HEARTBEAT_INTERVAL=5    # seconds
AGENT_POLL_INTERVAL=1         # seconds
AGENT_MAX_RETRIES=3

# --- Simulation ---
DEFAULT_RANDOM_SEED=42
SIMULATION_SPEED_MULTIPLIER=1.0   # 1.0 = real-time, 0.1 = 10x faster

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
